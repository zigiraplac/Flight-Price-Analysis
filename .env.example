# Copy this file to `.env` and fill in real values before running `docker-compose up`.
# `.env` is git-ignored; this file is committed so the stack is reproducible from a clean clone.

# --- MySQL staging ---
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=staging
MYSQL_USER=staging_user
MYSQL_PASSWORD=changeme_staging

# --- PostgreSQL: one instance, two schemas (airflow=metadata, analytics=warehouse) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=warehouse

# --- Airflow ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=changeme_generate_a_random_string
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=changeme_admin
